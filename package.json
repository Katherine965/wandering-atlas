{
  "name": "wandering-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node --experimental-strip-types scripts/release-licenses.ts --copy",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --experimental-strip-types scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app scripts tests vite.config.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:boundaries": "node --test --experimental-strip-types tests/runtime-boundaries.test.ts",
    "scan": "node scripts/scan.mjs",
    "test:browser": "playwright test",
    "dev:local": "node --experimental-strip-types scripts/local-dev.ts",
    "export:public": "node --experimental-strip-types scripts/export-public.ts",
    "preview:export": "node --experimental-strip-types scripts/serve.ts --public-export",
    "test:local-browser": "playwright test --config playwright.local.config.ts",
    "recover:local-lock": "node --experimental-strip-types scripts/recover-lock.ts",
    "check:release": "node --experimental-strip-types scripts/release-licenses.ts --ready"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "d3-geo": "3.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.3.4"
  },
  "packageManager": "npm@10.9.4"
}
